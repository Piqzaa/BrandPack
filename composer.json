{
    "name": "brandpack/brandpack",
    "description": "A logo handoff platform.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "autoload": {"psr-4": {"App\\": "src/"}},
    "config": {"allow-plugins": {"symfony/flex": true, "symfony/runtime": true}, "sort-packages": true},
    "extra": {"symfony": {"allow-contrib": false, "require": "7.4.*"}},
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
